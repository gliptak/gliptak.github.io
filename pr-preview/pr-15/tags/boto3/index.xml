&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> put_attributes(sdb, domain, &lt;span style="color:#e6db74">&amp;#34;id2&amp;#34;&lt;/span>, &lt;span style="color:#e6db74">&amp;#34;redblue&amp;#34;&lt;/span>)
